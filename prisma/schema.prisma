// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  isAdmin   Boolean  @default(false)
  profileImageUrl String?
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  value     Float
  co2Kg     Float
  createdAt DateTime @default(now())
}
model WasteReport {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  imageUrl    String?
  category    String
  city        String?
  priority    String   @default("medium")
  latitude    Float
  longitude   Float
  status      String   @default("pending") // pending, resolved
  department        String?
  slaDeadline       DateTime?
  citizenVerified   Boolean?
  citizenFeedback   String?
  createdAt   DateTime @default(now())
}

model RecyclingCenter {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String?
  latitude  Float
  longitude Float
  type      String   // plastic, e-waste, paper, etc.
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  type      String   // air_quality, flood, heatwave, etc.
  message   String
  region    String
  severity  String   @default("moderate")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String   // tree_plantation, cleanup_drive, campaign
  location    String
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model EventParticipant {
  id       String   @id @default(uuid())
  eventId  String
  userId   String
  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
}
model GreenPoints {
  id        String   @id @default(uuid())
  userId    String   @unique
  points    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Badge {
  id          String @id @default(uuid())
  name        String
  description String
  icon        String
  pointsCost  Int    @default(0)
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
model Challenge {
  id            String   @id @default(uuid())
  title         String
  description   String
  pointsReward  Int      @default(100)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model UserChallenge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  joinedAt    DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, challengeId])
}
model AgentLog {
  id             String   @id @default(uuid())
  userId         String?
  agentName      String   @default("eco_agent")
  action         String
  input          String
  decision       String
  reasoning      String
  toolCalls      Json?
  status         String   @default("completed") // completed, failed
  wasteReportId  String?
  createdAt      DateTime @default(now())

}
model SustainabilityPlan {
  id        String   @id @default(uuid())
  userId    String
  days      Json     // [{ day: 1, action: "...", reason: "..." }, ...]
  summary   String
  createdAt DateTime @default(now())
}

model UserGoal {
  id        String   @id @default(uuid())
  userId    String   @unique
  goal      String?  // free-text sustainability goal the user has set
  updatedAt DateTime @updatedAt
}

model AiRecommendation {
  id          String    @id @default(uuid())
  userId      String
  agentName   String    // "carbon_agent", "waste_agent", etc.
  message     String
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
model ComplaintAuditLog {
  id           String   @id @default(uuid())
  wasteReportId String
  fromStatus   String?
  toStatus     String
  actorId      String
  actorRole    String   // "citizen" or "authority"
  note         String?
  createdAt    DateTime @default(now())
}

